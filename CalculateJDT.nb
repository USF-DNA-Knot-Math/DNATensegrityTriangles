Cell[TextData[{
 StyleBox["The program below computes smoothness at vertex connection in the \
center strand loop, restricted to the set Phi, which means the purple graph \
in Appendix A.\n",
  FontSize->14,
  FontWeight->"Bold"],
 StyleBox["An example to call the program after executing it is,",
  FontSize->10],
 StyleBox[" ComputeSmoothnessPurple[7, 0, 360, 10],",
  FontSize->10,
  FontSlant->"Italic"],
 StyleBox[" which computes smoothness of center strand for 2T7 from 0 to 360 \
degrees at every 10 degree rotation, only if the dot product between the \
vectors is positive.",
  FontSize->10]
}], "Text",
 CellChangeTimes->{{3.902956974551263*^9, 
  3.9029570484194927`*^9}},ExpressionUUID->"b5deab57-b745-48eb-9d3a-\
a6d0657c1146"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ComputeSmoothnessPurple", "[", 
   RowBox[{"baselength_", ",", " ", "etS_", ",", " ", "etE_", ",", "etI_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "angleT0", ",", "angleT1", ",", " ", "crProd", ",", " ", "dtProd", ",", 
      RowBox[{"resultList", "=", 
       RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"angleT0", "=", 
      RowBox[{"ArcTan", "[", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"tauZ", "[", "baselength", "]"}], "/", 
         RowBox[{"tauX", "[", "baselength", "]"}]}], ")"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"angleT1", "=", 
      RowBox[{"ArcTan", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"tauY", "[", "baselength", "]"}]}], "+", "1"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"tauX", "[", "baselength", "]"}], "*", 
           RowBox[{"Cos", "[", "angleT0", "]"}]}], "+", 
          RowBox[{
           RowBox[{"Sin", "[", "angleT0", "]"}], "*", 
           RowBox[{"tauZ", "[", "baselength", "]"}]}]}], ")"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"r5", "=", 
      RowBox[{"RotationTransform", "[", 
       RowBox[{"angleT0", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"r6", "=", 
      RowBox[{"RotationTransform", "[", 
       RowBox[{"angleT1", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"thirdVertex", "=", 
      RowBox[{"eqTri", "[", 
       RowBox[{
        RowBox[{"r6", "[", 
         RowBox[{"r5", "[", 
          RowBox[{"moveInitialPoint", "[", 
           RowBox[{"r", "[", 
            RowBox[{"2", "Pi", "*", 
             RowBox[{"baselength", "/", "h"}]}], "]"}], "]"}], "]"}], "]"}], 
        "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tri12", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Simplify", "[", 
            RowBox[{"r6", "[", 
             RowBox[{"r5", "[", 
              RowBox[{"moveInitialPoint", "[", 
               RowBox[{"r", "[", 
                RowBox[{"2", "Pi", "*", 
                 RowBox[{"baselength", "/", "h"}]}], "]"}], "]"}], "]"}], 
             "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", "0"}], " ", "}"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Values", "[", 
           RowBox[{
            RowBox[{"thirdVertex", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
          RowBox[{"Values", "[", 
           RowBox[{
            RowBox[{"thirdVertex", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"centerpt12", "=", 
      RowBox[{"TriangleCenter", "[", 
       RowBox[{"tri12", ",", "\"\<Incenter\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"C2byTriCenter", "=", 
      RowBox[{"RotationTransform", "[", 
       RowBox[{
        RowBox[{"2", 
         RowBox[{"Pi", "/", "3"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"centerpt12", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"centerpt12", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", " ", "0"}], "}"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"et", "=", "etS"}], ",", 
       RowBox[{"et", "<", "etE"}], ",", " ", 
       RowBox[{"et", "+=", "etI"}], ",", " ", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"etRotate", "=", 
         RowBox[{"RotationTransform", "[", 
          RowBox[{
           RowBox[{"et", " ", "Degree"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";", " ", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Unit", " ", "tangent", " ", "vector", " ", "at", " ", "the", " ", 
          "end", " ", "of", " ", "C1"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"uEt1", "[", "t_", "]"}], "=", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"etRotate", "[", 
             RowBox[{"r6", "[", 
              RowBox[{"r5", "[", 
               RowBox[{"moveInitialPoint", "[", 
                RowBox[{"r", "[", "t", "]"}], "]"}], "]"}], "]"}], "]"}], ",",
             "t"}], "]"}], "/", 
          RowBox[{"Norm", "[", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"etRotate", "[", 
              RowBox[{"r6", "[", 
               RowBox[{"r5", "[", 
                RowBox[{"moveInitialPoint", "[", 
                 RowBox[{"r", "[", "t", "]"}], "]"}], "]"}], "]"}], "]"}], 
             ",", "t"}], "]"}], "]"}]}]}], " ", ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Unit", " ", "tangent", " ", "vector", " ", "at", " ", "the", " ", 
          "beginning", " ", "of", " ", "C2"}], "*)"}], "\[IndentingNewLine]", 
        
        RowBox[{
         RowBox[{"vT", "[", "t_", "]"}], "=", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"C2byTriCenter", "[", 
             RowBox[{"etRotate", "[", 
              RowBox[{"r6", "[", 
               RowBox[{"r5", "[", 
                RowBox[{"moveInitialPoint", "[", 
                 RowBox[{"r", "[", "t", "]"}], "]"}], "]"}], "]"}], "]"}], 
             "]"}], ",", "t"}], "]"}], "/", 
          RowBox[{"Norm", "[", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"C2byTriCenter", "[", 
              RowBox[{"etRotate", "[", 
               RowBox[{"r6", "[", 
                RowBox[{"r5", "[", 
                 RowBox[{"moveInitialPoint", "[", 
                  RowBox[{"r", "[", "t", "]"}], "]"}], "]"}], "]"}], "]"}], 
              "]"}], ",", "t"}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"crProd", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Norm", "[", 
           RowBox[{"Cross", "[", 
            RowBox[{
             RowBox[{"uEt1", "[", 
              RowBox[{"2", "Pi", "*", 
               RowBox[{"baselength", "/", "h"}]}], "]"}], ",", " ", 
             RowBox[{"vT", "[", "0", "]"}]}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dtProd", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Dot", "[", 
           RowBox[{
            RowBox[{"uEt1", "[", 
             RowBox[{"2", "Pi", "*", 
              RowBox[{"baselength", "/", "h"}]}], "]"}], ",", " ", 
            RowBox[{"vT", "[", "0", "]"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Smoothness", " ", "calculation", " ", "is", " ", "restricted", " ", 
          "to", " ", "the", " ", "set", " ", "Phi", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"in", " ", "Appendix", " ", "A"}], ")"}], "."}]}], "*)"}],
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"dtProd", ">=", "0"}], ",", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"resultList", ",", 
            RowBox[{"{", 
             RowBox[{"et", ",", "dtProd", ",", "crProd"}], "}"}]}], " ", 
           "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{
       "\"\</Users/van/Documents/Triangles/RawOut-h=10.1alpha34/ec1ic2-purple-\
n=\>\"", "<>", 
        RowBox[{"ToString", "[", "baselength", "]"}], "<>", "\"\<.txt\>\""}], 
       ",", " ", "resultList"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
