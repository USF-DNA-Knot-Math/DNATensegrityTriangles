Cell[TextData[{
 StyleBox["The program below calculate Tilt level. ",
  FontWeight->"Bold"],
 "\n",
 StyleBox["Run the program by placing your cursor within its source, then \
press \[OpenCurlyDoubleQuote]Shift + Return\[CloseCurlyDoubleQuote].\nAn \
example to call the program afterwards is, ",
  FontSize->10],
 StyleBox["VaryEtaFindTilt[7, 0, 360, 10], ",
  FontSize->10,
  FontSlant->"Italic"],
 StyleBox["which calculate Tilt level in the case n=7 for et=0 to et=360 at \
every increment of 10 degrees.",
  FontSize->10]
}], "Text",
 CellChangeTimes->{{3.902956100972597*^9, 3.9029563174217043`*^9}, {
  3.902956366724372*^9, 
  3.902956367543921*^9}},ExpressionUUID->"35d0a451-1380-4677-97e0-\
f62e3a5c3de1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VaryEtaFindTilt", "[", 
   RowBox[{"baselength_", ",", " ", "etS_", ",", " ", "etE_", ",", "etI_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"angleT0", ",", "angleT1", ",", "tilt", ",", 
      RowBox[{"resList", "=", 
       RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"angleT0", "=", 
      RowBox[{"ArcTan", "[", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"tauZ", "[", "baselength", "]"}], "/", 
         RowBox[{"tauX", "[", "baselength", "]"}]}], ")"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"angleT1", "=", 
      RowBox[{"ArcTan", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"tauY", "[", "baselength", "]"}]}], "+", "1"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"tauX", "[", "baselength", "]"}], "*", 
           RowBox[{"Cos", "[", "angleT0", "]"}]}], "+", 
          RowBox[{
           RowBox[{"Sin", "[", "angleT0", "]"}], "*", 
           RowBox[{"tauZ", "[", "baselength", "]"}]}]}], ")"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"r5", "=", 
      RowBox[{"RotationTransform", "[", 
       RowBox[{"angleT0", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"r6", "=", 
      RowBox[{"RotationTransform", "[", 
       RowBox[{"angleT1", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"et", "=", "etS"}], ",", 
       RowBox[{"et", "<", "etE"}], ",", " ", 
       RowBox[{"et", "+=", "etI"}], ",", " ", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"etRotate", "=", 
         RowBox[{"RotationTransform", "[", 
          RowBox[{
           RowBox[{"et", " ", "Degree"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";", " ", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{
           "Tilt", " ", "level", " ", "is", " ", "defined", " ", "as", " ", 
            "the", " ", "z"}], "-", 
           RowBox[{
           "component", " ", "of", " ", "the", " ", "terminal", " ", "point", 
            " ", "minus", " ", "that", " ", "of", " ", "the", " ", "initial", 
            " ", "point", " ", "of", " ", "C_", "1"}]}], ",", " ", 
          RowBox[{
          "adjusted", " ", "to", " ", "the", " ", "basepair", " ", 
           "length"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"tilt", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"etRotate", "[", 
             RowBox[{"r6", "[", 
              RowBox[{"r5", "[", 
               RowBox[{"moveInitialPoint", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"2", "Pi", "*", 
                   RowBox[{"baselength", "/", "h"}]}], ",", " ", 
                  RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], "]"}], "]"}], 
              "]"}], "]"}], "[", 
            RowBox[{"[", "3", "]"}], "]"}], "-", 
           RowBox[{
            RowBox[{"etRotate", "[", 
             RowBox[{"r6", "[", 
              RowBox[{"r5", "[", 
               RowBox[{"moveInitialPoint", "[", 
                RowBox[{"{", 
                 RowBox[{"0", ",", 
                  RowBox[{"-", "1"}], ",", "0"}], "}"}], "]"}], "]"}], "]"}], 
             "]"}], "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"resList", ",", 
          RowBox[{"{", 
           RowBox[{"et", ",", " ", 
            RowBox[{"tilt", "+", 
             RowBox[{"tilt", "/", "baselength"}]}]}], "}"}]}], " ", "]"}]}]}],
       "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Change", " ", "to", " ", "your", " ", "desired", " ", "location", " ", 
       "for", " ", "exporting", " ", "the", " ", "result"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{
       "\"\</Users/van/Documents/Triangles/RawOut-h=10.1alpha34/newtilt-n=\>\"\
", "<>", 
        RowBox[{"ToString", "[", "baselength", "]"}], "<>", "\"\<.txt\>\""}], 
       ",", " ", "resList"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.902955812261858*^9, 3.902955837996044*^9}, {
   3.9029558846390343`*^9, 3.9029559830845747`*^9}, {3.902956021731008*^9, 
   3.902956057503196*^9}, 
   3.9029573432657127`*^9},ExpressionUUID->"699640bc-3909-480e-9f29-\
