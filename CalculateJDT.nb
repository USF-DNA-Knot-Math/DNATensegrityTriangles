Cell[BoxData[{
 RowBox[{
  RowBox[{"alpha", "=", 
   RowBox[{"3.4", "/", 
    RowBox[{"(", 
     RowBox[{"2", "Pi"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"beta", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"moveInitialPoint", "[", "P_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "newP", "}"}], ",", 
    RowBox[{
     RowBox[{"newP", "=", "P"}], ";", " ", 
     RowBox[{
      RowBox[{"newP", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "=", 
      RowBox[{
       RowBox[{"P", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "-", "1"}]}], ";", " ", "newP"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqTri", "[", "x2_", "]"}], ":=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"0", "-", "x3"}], ")"}], "^", "2"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"0", "-", "y3"}], ")"}], "^", "2"}]}], "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"0", "-", "x2"}], ")"}], "^", "2"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x2", "-", "x3"}], ")"}], "^", "2"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"0", "-", "y3"}], ")"}], "^", "2"}]}], "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"0", "-", "x2"}], ")"}], "^", "2"}]}], ",", " ", 
       RowBox[{"y3", ">", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x3", ",", "y3"}], "}"}]}], "]"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", "=", "10.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", "[", "t_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"alpha", "*", "t"}], ",", 
    RowBox[{"Cos", "[", 
     RowBox[{"beta", " ", "*", "t"}], "]"}], ",", 
    RowBox[{"Sin", "[", 
     RowBox[{"beta", "*", " ", "t"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s", "[", "t_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"alpha", "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "Pi", "*", 
        RowBox[{"n", "/", "h"}]}], "-", "t"}], ")"}]}], ",", 
    RowBox[{"-", 
     RowBox[{"Cos", "[", 
      RowBox[{"beta", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "Pi", "*", 
          RowBox[{"n", "/", "h"}]}], "-", "t"}], ")"}]}], "]"}]}], ",", 
    RowBox[{"-", 
     RowBox[{"Sin", "[", 
      RowBox[{"beta", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "Pi", "*", 
          RowBox[{"n", "/", "h"}]}], "-", "t"}], ")"}]}], "]"}]}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", "[", 
   RowBox[{"m_", ",", " ", "k_"}], "]"}], ":=", 
  RowBox[{"2", "Pi", "*", 
   RowBox[{"m", "/", "k"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tauX", "[", "n1_", "]"}], ":=", 
  RowBox[{"alpha", "*", 
   RowBox[{"L", "[", 
    RowBox[{"n1", ",", "h"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tauY", "[", "n1_", "]"}], ":=", 
  RowBox[{"Cos", "[", 
   RowBox[{"beta", "*", 
    RowBox[{"L", "[", 
     RowBox[{"n1", ",", " ", "h"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tauZ", "[", "n1_", "]"}], ":=", 
  RowBox[{"Sin", "[", 
   RowBox[{"beta", "*", 
    RowBox[{"L", "[", 
     RowBox[{"n1", ",", "h"}], "]"}]}], "]"}]}]}], "Input",
