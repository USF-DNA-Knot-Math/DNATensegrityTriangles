484195641a0d"],

Cell[TextData[{
 StyleBox["The program below calculates the function D, internal cavity.",
  FontWeight->"Bold"],
 "\n",
 StyleBox["An example to call it (after execution) is,",
  FontSize->10],
 StyleBox[" ComputeInternalCavity[7, 0, 360, 5],",
  FontSize->10,
  FontSlant->"Italic"],
 StyleBox[" which calculates the distance from the triangle centroid to the \
side of the cylinder that contains C_1.",
  FontSize->10]
}], "Text",
 CellChangeTimes->{{3.902957147615777*^9, 
  3.902957240850144*^9}},ExpressionUUID->"4aabdc29-0e6a-4e8e-8cc1-\
f480ddce1b42"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ComputeInternalCavity", "[", 
   RowBox[{"baselength_", ",", " ", "etS_", ",", " ", "etE_", ",", "etI_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"angleT0", ",", "angleT1", ",", 
      RowBox[{"dis", "=", "0"}], ",", 
      RowBox[{"resList", "=", 
       RowBox[{"{", "}"}]}]}], "}"}], ",", "\n", "\n", 
    RowBox[{
     RowBox[{"angleT0", "=", 
      RowBox[{"ArcTan", "[", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"tauZ", "[", "baselength", "]"}], "/", 
         RowBox[{"tauX", "[", "baselength", "]"}]}], ")"}], "]"}]}], ";", 
     "\n", 
     RowBox[{"angleT1", "=", 
      RowBox[{"ArcTan", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"tauY", "[", "baselength", "]"}]}], "+", "1"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"tauX", "[", "baselength", "]"}], "*", 
           RowBox[{"Cos", "[", "angleT0", "]"}]}], "+", 
          RowBox[{
           RowBox[{"Sin", "[", "angleT0", "]"}], "*", 
           RowBox[{"tauZ", "[", "baselength", "]"}]}]}], ")"}]}], "]"}]}], 
     ";", "\n", 
     RowBox[{"r5", "=", 
      RowBox[{"RotationTransform", "[", 
       RowBox[{"angleT0", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}]}], "]"}]}], ";", 
     "\n", 
     RowBox[{"r6", "=", 
      RowBox[{"RotationTransform", "[", 
       RowBox[{"angleT1", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], ";", 
     "\n", 
     RowBox[{"thirdVertex", "=", 
      RowBox[{"eqTri", "[", 
       RowBox[{
        RowBox[{"r6", "[", 
         RowBox[{"r5", "[", 
          RowBox[{"moveInitialPoint", "[", 
           RowBox[{"r", "[", 
            RowBox[{"2", "Pi", "*", 
             RowBox[{"baselength", "/", "h"}]}], "]"}], "]"}], "]"}], "]"}], 
        "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{"tri12", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Simplify", "[", 
            RowBox[{"r6", "[", 
             RowBox[{"r5", "[", 
              RowBox[{"moveInitialPoint", "[", 
               RowBox[{"r", "[", 
                RowBox[{"2", "Pi", "*", 
                 RowBox[{"baselength", "/", "h"}]}], "]"}], "]"}], "]"}], 
             "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", "0"}], " ", "}"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Values", "[", 
           RowBox[{
            RowBox[{"thirdVertex", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
          RowBox[{"Values", "[", 
           RowBox[{
            RowBox[{"thirdVertex", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}]}], "}"}]}], ";", 
     "\n", 
     RowBox[{"centerpt12", "=", 
      RowBox[{"TriangleCenter", "[", 
       RowBox[{"tri12", ",", "\"\<Incenter\>\""}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"et", "=", "etS"}], ",", 
       RowBox[{"et", "<", "etE"}], ",", " ", 
       RowBox[{"et", "+=", "etI"}], ",", " ", "\n", 
       RowBox[{
        RowBox[{"etRotate", "=", 
         RowBox[{"RotationTransform", "[", 
          RowBox[{
           RowBox[{"et", " ", "Degree"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";", " ", 
        "\n", "\n", 
        RowBox[{"dis", "=", 
         RowBox[{"SignedRegionDistance", "[", 
          RowBox[{
           RowBox[{"Cylinder", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"etRotate", "[", 
                RowBox[{"r6", "[", 
                 RowBox[{"r5", "[", 
                  RowBox[{"moveInitialPoint", "[", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], "]"}],
                   "]"}], "]"}], "]"}], ",", 
               RowBox[{"N", "[", 
                RowBox[{"etRotate", "[", 
                 RowBox[{"r6", "[", 
                  RowBox[{"r5", "[", 
                   RowBox[{"moveInitialPoint", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"2", "Pi", "*", 
                    RowBox[{"baselength", "/", "h"}]}], ",", " ", "0", ",", 
                    " ", "0"}], "}"}], "]"}], "]"}], "]"}], "]"}], "]"}]}], 
              "}"}], ",", " ", "1"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"centerpt12", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"centerpt12", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", " ", "0"}], "}"}]}], 
          "]"}]}], ";", "\n", "\n", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"resList", ",", 
          RowBox[{"{", 
           RowBox[{"et", ",", "dis"}], "}"}]}], " ", "]"}]}]}], "\n", "\n", 
      "]"}], ";", "\n", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{
       "\"\</Users/van/Documents/Triangles/RawOut-h=10.1alpha34/cyl2cenSigned-\
n=\>\"", "<>", 
        RowBox[{"ToString", "[", "baselength", "]"}], "<>", "\"\<.txt\>\""}], 
       ",", " ", "resList"}], "]"}]}]}], "\n", "\n", "]"}]}]], "Input",
 CellChangeTimes->{{3.902957105356535*^9, 3.902957136177903*^9}, 
   3.902957355827586*^9},ExpressionUUID->"dd33b23e-0279-44db-add9-\
33e00b927fd4"]
},
